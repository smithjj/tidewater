// Port of the kernel of src/ocean/WaterQuery.js: water surface queries on the GPU.
//   - slot 0 is always the camera (consumed the same frame by the waterline / underwater passes)
//   - other slots are gameplay points (boat hull samples, swimmer, particles...)
// Results are read back asynchronously for CPU physics (1-3 frames latency).
//
// Height is Eulerian: the FFT displacement is Lagrangian (x0 -> x0 + D(x0)), so x0 + D(x0) = xz is solved with a few
// fixed-point iterations. Shore waves and the wake add to the displacement once ported (see WaterQueryDispAt).

#pragma kernel WaterQueries
#pragma multi_compile _ TW_SHORE_ORACLE   // exact per-wave hash for the JS oracle (see ShoreWaves.hlsl)

#define TW_NO_NORMAL_ROCK
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "../Terrain/TerrainHeight.hlsl"
#include "../Common/Noise.hlsl"
#include "ShoreWaves.hlsl"

#include "WaterQueryHeight.hlsl"

#define MAX_QUERIES 256u

StructuredBuffer<float4> _QueryInputs;
RWStructuredBuffer<float4> _QueryResults;

[numthreads( 64, 1, 1 )]
void WaterQueries( uint3 gid : SV_DispatchThreadID )
{
	uint i = gid.x;
	if ( i >= MAX_QUERIES ) { return; }
	float4 q = _QueryInputs[ i ];
	float2 xz = q.xy;
	float h = WaterQueryHeightAtXZ( xz );
	float e = 0.35;
	float hx = WaterQueryHeightAtXZ( xz + float2( e, 0.0 ) );
	float hz = WaterQueryHeightAtXZ( xz + float2( 0.0, e ) );
	float3 n = normalize( float3( ( h - hx ) / e, 1.0, ( h - hz ) / e ) );
	float seaFloor = _QAmp.z > 0.5 ? TWHeightAt( xz ) : -500.0;
	_QueryResults[ i ] = float4( h, n.x, n.z, seaFloor );
}
